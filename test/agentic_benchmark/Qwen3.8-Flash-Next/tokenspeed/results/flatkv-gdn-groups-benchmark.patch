+@pytest.mark.parametrize("state_groups", [1, 6, 18])
+def test_flat_kv_explicit_gdn_groups_keep_each_layers_state(state_groups):
+    from tokenspeed.runtime.layers.attention.kv_cache.factory import create_cache_pool
+
+    recipe = _six_group_recipe(
+        flat=True, device="cpu", kv_dtype=torch.bfloat16, state_layers=36
+    )
+    recipe.server_args.qwen4_exp_flat_kv_gdn_groups = state_groups
+    setup = recipe.setup()
+    plan = setup.spec.memory_plan
+    arena = CacheArena(plan, "cpu", cache_group_specs=setup.spec.cache_group_specs)
+    pool = create_cache_pool(
+        setup.spec.layer_view(first_layer=0, num_layers=setup.num_target_layers),
+        recipe.attn_config,
+        arena,
+        num_layers=setup.num_target_layers,
+        rank=0,
+        field_layer_offset=0,
+    )
+    assert len(set(pool.state_group_by_layer.values())) == state_groups
+    for layer in range(36):
+        gid = pool.state_group_by_layer[layer]
+        assert gid == f"linear_attention_{layer % state_groups}"
+        block = 1 + layer % state_groups
+        for component, suffix, marker in (
+            ("conv_state", "conv", 100 + layer),
+            ("recurrent_state", "ssm", 200 + layer),
+        ):
+            pool.get_component(layer, component)[block].reshape(-1)[0] = marker
+    # Read after every layer has written, so aliasing across groups or layers
+    # overwrites a value and is observable through the original arena fields.
+    for layer in range(36):
+        block = 1 + layer % state_groups
+        assert arena.field(f"layer.{layer}.conv")[block].reshape(-1)[0] == 100 + layer
+        assert arena.field(f"layer.{layer}.ssm")[block].reshape(-1)[0] == 200 + layer
+
+
