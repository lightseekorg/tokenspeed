+    #[test]
+    fn polled_load_has_the_same_rank_scope_as_a_pushed_record() {
+        let loads = vec![
+            SchedulerLoadSnapshot {
+                dp_rank: 0,
+                num_running_reqs: 8,
+                num_waiting_reqs: 20,
+                num_total_reqs: 28,
+                num_waiting_uncached_tokens: 64000,
+                ..Default::default()
+            },
+            SchedulerLoadSnapshot {
+                dp_rank: 1,
+                num_running_reqs: 1,
+                num_waiting_reqs: 2,
+                num_total_reqs: 3,
+                num_waiting_uncached_tokens: 4000,
+                ..Default::default()
+            },
+        ];
+        let report = WorkerLoadResponse {
+            dp_rank_count: 2,
+            aggregate: EngineAggregateMetricsSnapshot::from_ranks(&loads),
+            loads,
+            ..Default::default()
+        };
+        let scoped = WorkerMonitor::load_for_rank(report.clone(), Some(1)).unwrap();
+        assert_eq!(scoped.dp_rank_count, 1);
+        assert_eq!(scoped.loads.len(), 1);
+        assert_eq!(scoped.loads[0].dp_rank, 1);
+        assert_eq!(scoped.total_running_reqs(), 1);
+        assert_eq!(scoped.total_waiting_reqs(), 2);
+        assert_eq!(scoped.total_waiting_uncached_tokens(), 4000);
+        assert_eq!(scoped.aggregate.unwrap().total_reqs, 3);
+        assert!(WorkerMonitor::load_for_rank(report.clone(), Some(2)).is_none());
+        let whole = WorkerMonitor::load_for_rank(report, None).unwrap();
+        assert_eq!(whole.loads.len(), 2);
+        assert_eq!(whole.total_waiting_reqs(), 22);
+    }
