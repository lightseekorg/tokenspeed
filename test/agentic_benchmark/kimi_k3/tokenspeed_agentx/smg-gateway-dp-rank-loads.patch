+    fn load_for_rank(
+        mut load: WorkerLoadResponse,
+        rank: Option<usize>,
+    ) -> Option<WorkerLoadResponse> {
+        let Some(rank) = rank else {
+            return Some(load);
+        };
+        if !load.ranks_are_dp_ranks() {
+            return None;
+        }
+        load.loads
+            .retain(|entry| usize::try_from(entry.dp_rank) == Ok(rank));
+        if load.loads.len() != 1 {
+            return None;
+        }
+        load.dp_rank_count = 1;
+        load.aggregate = EngineAggregateMetricsSnapshot::from_ranks(&load.loads);
+        Some(load)
+    }
