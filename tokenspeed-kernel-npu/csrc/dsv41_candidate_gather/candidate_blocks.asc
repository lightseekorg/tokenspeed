#include "kernel_operator.h"
using namespace AscendC;
__global__ __aicore__ void gather_blocks(GM_ADDR cache_p, GM_ADDR ids_p, GM_ADDR out_p, int64_t count,
                                         int64_t capacity) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GlobalTensor<uint16_t> cache, out;
    GlobalTensor<int32_t> ids;
    cache.SetGlobalBuffer((__gm__ uint16_t*)cache_p);
    out.SetGlobalBuffer((__gm__ uint16_t*)out_p);
    ids.SetGlobalBuffer((__gm__ int32_t*)ids_p);
    TPipe pipe;
    TBuf<TPosition::VECCALC> data_buf, index_buf;
    pipe.InitBuffer(data_buf, 64 * 1024 * 2);
    pipe.InitBuffer(index_buf, 64 * 4);
    auto data = data_buf.Get<uint16_t>();
    auto slots = index_buf.Get<int32_t>();
    for (int64_t begin = (int64_t)GetBlockIdx() * 64; begin < count; begin += (int64_t)GetBlockNum() * 64) {
        int n = (int)(count - begin < 64 ? count - begin : 64);
        DataCopyPad(slots, ids[begin], DataCopyExtParams{1, (uint32_t)n * 4, 0, 0, 0},
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        Duplicate(data, (uint16_t)0, n * 1024);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
        SetFlag<HardEvent::MTE2_S>(0);
        WaitFlag<HardEvent::MTE2_S>(0);
        for (int i = 0; i < n; i++) {
            int64_t id = slots.GetValue(i);
            if (id >= 0 && id < capacity) DataCopy(data[i * 1024], cache[id * 1024], 1024);
        }
        SetFlag<HardEvent::MTE2_MTE3>(0);
        WaitFlag<HardEvent::MTE2_MTE3>(0);
        DataCopy(out[begin * 1024], data, n * 1024);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::S_MTE2>(0);
        WaitFlag<HardEvent::S_MTE2>(0);
    }
}
extern "C" void launch_blocks(void* cache, void* ids, void* out, int64_t count, int64_t capacity, void* stream) {
    gather_blocks<<<48, nullptr, stream>>>((GM_ADDR)cache, (GM_ADDR)ids, (GM_ADDR)out, count, capacity);
}
