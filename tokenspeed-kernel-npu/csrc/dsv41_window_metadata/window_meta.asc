#include "kernel_operator.h"
using namespace AscendC;
struct WindowShape {
    int n, tr, tc, pages;
    int pbytes, rbytes, tbytes, pair_r_bytes, read_bytes;
    int64_t ps, rs, ts0, ts1;
};
__aicore__ inline __attribute__((always_inline)) int64_t ReadInt(GM_ADDR pointer, int64_t index, int bytes) {
    if (bytes == 8) {
        GlobalTensor<int64_t> tensor;
        tensor.SetGlobalBuffer((__gm__ int64_t*)pointer);
        return tensor.GetValue(index);
    }
    GlobalTensor<int32_t> tensor;
    tensor.SetGlobalBuffer((__gm__ int32_t*)pointer);
    return tensor.GetValue(index);
}
__aicore__ inline __attribute__((always_inline)) int64_t Slot(GM_ADDR table, int64_t p, int64_t r, const WindowShape& s,
                                                              int rows) {
    if (p < 0 || r < 0 || r >= s.tr || p / rows >= s.tc) return -1;
    int64_t page = ReadInt(table, r * s.ts0 + (p / rows) * s.ts1, s.tbytes);
    return page >= 1 && page < s.pages ? page * rows + p % rows : -1;
}
__aicore__ inline __attribute__((always_inline)) void StoreInt(GM_ADDR pointer, int row, int bytes,
                                                               LocalTensor<int64_t> values, int index) {
    GlobalTensor<uint8_t> tensor;
    tensor.SetGlobalBuffer((__gm__ uint8_t*)pointer);
    // Every DMA source starts at a separate 32-byte-aligned UB slot.
    DataCopyPad(tensor[(int64_t)row * bytes], values.ReinterpretCast<uint8_t>()[index * 32],
                DataCopyExtParams{1, (uint32_t)bytes, 0, 0, 0});
}
__global__ __aicore__ void window_meta(GM_ADDR pp, GM_ADDR rp, GM_ADDR table, GM_ADDR write, GM_ADDR read, GM_ADDR lens,
                                       WindowShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> wb, mb;
    pipe.InitBuffer(wb, 1024);
    pipe.InitBuffer(mb, 192);
    auto wide = wb.Get<int64_t>();
    auto narrow = wb.Get<int32_t>();
    auto meta = mb.Get<int64_t>();
    for (int row = GetBlockIdx(); row < s.n; row += GetBlockNum()) {
        int64_t p = ReadInt(pp, (int64_t)row * s.ps, s.pbytes);
        int64_t r = ReadInt(rp, (int64_t)row * s.rs, s.rbytes);
        int64_t start = p > 127 ? p - 127 : 0;
        int64_t prior_col = -1, page = -1;
        for (int col = 0; col < 128; ++col) {
            int64_t wanted = start + col;
            int64_t slot = -1;
            if (wanted <= p && r >= 0 && r < s.tr && wanted / 64 < s.tc) {
                int64_t page_col = wanted / 64;
                if (page_col != prior_col) {
                    page = ReadInt(table, r * s.ts0 + page_col * s.ts1, s.tbytes);
                    prior_col = page_col;
                }
                if (page >= 1 && page < s.pages) slot = page * 64 + wanted % 64;
            }
            if (s.read_bytes == 8)
                wide.SetValue(col, slot);
            else
                narrow.SetValue(col, (int32_t)slot);
        }
        meta.SetValue(0, Slot(table, p, r, s, 64));
        int64_t length = (int64_t)((uint64_t)p + 1);
        if (s.pbytes == 4) length = (int32_t)((uint32_t)p + 1);
        meta.SetValue(4, length < 0 ? 0 : (length > 128 ? 128 : length));
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        GlobalTensor<uint8_t> out;
        out.SetGlobalBuffer((__gm__ uint8_t*)read);
        DataCopy(out[(int64_t)row * 128 * s.read_bytes], wb.Get<uint8_t>(), 128 * s.read_bytes);
        StoreInt(write, row, 8, meta, 0);
        StoreInt(lens, row, 4, meta, 1);
        SetFlag<HardEvent::MTE3_S>(0);
        WaitFlag<HardEvent::MTE3_S>(0);
    }
}
__global__ __aicore__ void compressor_meta(GM_ADDR pp, GM_ADDR rp, GM_ADDR table, GM_ADDR active, GM_ADDR pair_p,
                                           GM_ADDR pair_r, GM_ADDR previous, GM_ADDR read, GM_ADDR write,
                                           WindowShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> mb;
    pipe.InitBuffer(mb, 192);
    auto meta = mb.Get<int64_t>();
    for (int row = GetBlockIdx(); row < s.n; row += GetBlockNum()) {
        int64_t p = ReadInt(pp, (int64_t)row * s.ps, s.pbytes);
        int64_t r = ReadInt(rp, (int64_t)row * s.rs, s.rbytes);
        bool live = p >= 0 && (p & 1);
        int64_t pair_pos = live ? p - 1 : -1, pair_req = live ? r : -1;
        int64_t prev = -1;
        if (row > 0 && live && r >= 0 && ReadInt(pp, (int64_t)(row - 1) * s.ps, s.pbytes) == pair_pos &&
            ReadInt(rp, (int64_t)(row - 1) * s.rs, s.rbytes) == r)
            prev = row - 1;
        meta.SetValue(0, live);
        meta.SetValue(4, pair_pos);
        meta.SetValue(8, pair_req);
        meta.SetValue(12, prev);
        meta.SetValue(16, Slot(table, pair_pos, pair_req, s, 2));
        meta.SetValue(20, Slot(table, p, r, s, 2));
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        StoreInt(active, row, 1, meta, 0);
        StoreInt(pair_p, row, 8, meta, 1);
        StoreInt(pair_r, row, s.pair_r_bytes, meta, 2);
        StoreInt(previous, row, 8, meta, 3);
        StoreInt(read, row, 8, meta, 4);
        StoreInt(write, row, 8, meta, 5);
        SetFlag<HardEvent::MTE3_S>(0);
        WaitFlag<HardEvent::MTE3_S>(0);
    }
}
extern "C" void launch_window(void* p, void* r, void* table, void* write, void* read, void* lens, WindowShape s,
                              void* stream) {
    window_meta<<<48, nullptr, stream>>>((GM_ADDR)p, (GM_ADDR)r, (GM_ADDR)table, (GM_ADDR)write, (GM_ADDR)read,
                                         (GM_ADDR)lens, s);
}
extern "C" void launch_compressor(void* p, void* r, void* table, void* active, void* pair_p, void* pair_r,
                                  void* previous, void* read, void* write, WindowShape s, void* stream) {
    compressor_meta<<<48, nullptr, stream>>>((GM_ADDR)p, (GM_ADDR)r, (GM_ADDR)table, (GM_ADDR)active, (GM_ADDR)pair_p,
                                             (GM_ADDR)pair_r, (GM_ADDR)previous, (GM_ADDR)read, (GM_ADDR)write, s);
}
