#define ASCENDC_CUBE_ONLY
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
using namespace AscendC;
using namespace matmul;
using A = MatmulType<TPosition::GM, CubeFormat::ND, int4b_t>;
using B = MatmulType<TPosition::GM, CubeFormat::NZ, int4b_t, true>;
using C = MatmulType<TPosition::GM, CubeFormat::ND, half>;
using Bias = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
constexpr MatmulConfig config = GetMDLConfig(false, false, 0, true, false, false, true);
constexpr int kM = 64, kN = 512;
struct ExpertShape {
    int k, n, experts;
};
__global__ __aicore__ void grouped_w4a4(GM_ADDR ap, GM_ADDR bp, GM_ADDR sp, GM_ADDR cp, GM_ADDR tp, GM_ADDR yp,
                                        GM_ADDR wp, GM_ADDR tiling, ExpertShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe pipe;
    GlobalTensor<int64_t> counts;
    counts.SetGlobalBuffer((__gm__ int64_t*)cp);
    GlobalTensor<half> scratch;
    scratch.SetGlobalBuffer((__gm__ half*)wp);
    if ASCEND_IS_AIC {
        TCubeTiling t;
        auto src = (__gm__ int32_t*)tiling;
        auto dst = (int32_t*)&t;
        for (int i = 0; i < sizeof(t) / 4; i++) dst[i] = src[i];
        Matmul<A, B, C, Bias, config> mm;
        mm.Init(&t, &pipe);
        GlobalTensor<int4b_t> a, b;
        GlobalTensor<uint64_t> scale;
        a.SetGlobalBuffer((__gm__ int4b_t*)ap);
        b.SetGlobalBuffer((__gm__ int4b_t*)bp);
        scale.SetGlobalBuffer((__gm__ uint64_t*)sp);
        int core = GetBlockIdx(), job = core, start = 0, prior = 0, tilesN = (s.n + kN - 1) / kN, iteration = 0;
        for (int e = 0; e < s.experts; e++) {
            int m = counts.GetValue(e), tiles = ((m + kM - 1) / kM) * tilesN;
            while (job < prior + tiles) {
                int local = job - prior, row = (local / tilesN) * kM, col = (local % tilesN) * kN;
                int rows = m - row < kM ? m - row : kM, cols = s.n - col < kN ? s.n - col : kN;
                mm.SetOrgShape(m, s.n, s.k);
                mm.SetSingleShape(rows, cols, s.k);
                mm.SetTensorA(a[(int64_t)(start + row) * s.k]);
                auto weight = b[(int64_t)e * s.n * s.k + (int64_t)col * 64];
                if (m <= kM) weight.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
                mm.SetTensorB(weight, true);
                mm.SetQuantVector(scale[(int64_t)e * s.n + col]);
                // Drain the iterator before advancing to another expert tile.
                // MDL retains completion state until its final false return.
                while (mm.Iterate()) {
                    CrossCoreWaitFlag(4 + iteration % 2);
                    mm.GetTensorC(scratch[((int64_t)core * 2 + iteration % 2) * kM * kN], 0, true);
                    CrossCoreSetFlag<2, PIPE_FIX>(2 + iteration % 2);
                    iteration++;
                }
                job += 24;
            }
            start += m;
            prior += tiles;
        }
        mm.End();
    } else {
        const int core = GetBlockIdx() / 2, sub = GetSubBlockIdx();
        GlobalTensor<float> ts;
        ts.SetGlobalBuffer((__gm__ float*)tp);
        GlobalTensor<bfloat16_t> y;
        y.SetGlobalBuffer((__gm__ bfloat16_t*)yp);
        TBuf<TPosition::VECCALC> hb, fb, ob;
        pipe.InitBuffer(hb, 64 * 256 * 2);
        pipe.InitBuffer(fb, 64 * 256 * 4);
        pipe.InitBuffer(ob, 64 * 256 * 2);
        auto h = hb.Get<half>();
        auto f = fb.Get<float>();
        auto out = ob.Get<bfloat16_t>();
        for (int bank = 0; bank < 2; bank++) {
            CrossCoreSetFlag<2, PIPE_MTE2>(4 + bank);
            PipeBarrier<PIPE_MTE2>();
        }
        int job = core, start = 0, prior = 0, tilesN = (s.n + kN - 1) / kN, iteration = 0;
        for (int e = 0; e < s.experts; e++) {
            int m = counts.GetValue(e), tiles = ((m + kM - 1) / kM) * tilesN;
            while (job < prior + tiles) {
                int local = job - prior, row = (local / tilesN) * kM, col = (local % tilesN) * kN;
                int rows = m - row < kM ? m - row : kM, cols = s.n - col < kN ? s.n - col : kN;
                int halfN = kN / 2;
                CrossCoreWaitFlag(2 + iteration % 2);
                DataCopyPad(h, scratch[((int64_t)core * 2 + iteration % 2) * kM * kN + sub * halfN],
                            DataCopyExtParams{(uint16_t)rows, (uint32_t)halfN * 2, (uint32_t)(kN - halfN) * 2, 0, 0},
                            DataCopyPadExtParams<half>{false, 0, 0, 0});
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(f, h, RoundMode::CAST_NONE, rows * halfN);
                PipeBarrier<PIPE_V>();
                for (int r = 0; r < rows; r++) Muls(f[r * halfN], f[r * halfN], ts.GetValue(start + row + r), halfN);
                PipeBarrier<PIPE_V>();
                Cast(out, f, RoundMode::CAST_RINT, rows * halfN);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                DataCopyPad(y[(int64_t)(start + row) * s.n + col + sub * halfN], out,
                            DataCopyExtParams{(uint16_t)rows, (uint32_t)halfN * 2, 0, (uint32_t)(s.n - halfN) * 2, 0});
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                CrossCoreSetFlag<2, PIPE_MTE3>(4 + iteration % 2);
                job += 24;
                iteration++;
            }
            start += m;
            prior += tiles;
        }
    }
}
extern "C" void launch_w4a4(void* a, void* b, void* s, void* c, void* ts, void* y, void* w, void* t, int k, int n,
                            int e, void* stream) {
    grouped_w4a4<<<24, nullptr, stream>>>((GM_ADDR)a, (GM_ADDR)b, (GM_ADDR)s, (GM_ADDR)c, (GM_ADDR)ts, (GM_ADDR)y,
                                          (GM_ADDR)w, (GM_ADDR)t, ExpertShape{k, n, e});
}
