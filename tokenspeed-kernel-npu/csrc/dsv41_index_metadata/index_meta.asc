#include "kernel_operator.h"
using namespace AscendC;
struct MetaShape {
    int rows, width, pages, candidates, stride;
    int64_t ts, vs, cs;
};
__global__ __aicore__ void index_meta(GM_ADDR tp, GM_ADDR vp, GM_ADDR cp, GM_ADDR mp, GM_ADDR np, GM_ADDR op,
                                      MetaShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GlobalTensor<int32_t> table, visible, candidates, mapping, native, counts;
    table.SetGlobalBuffer((__gm__ int32_t*)tp);
    visible.SetGlobalBuffer((__gm__ int32_t*)vp);
    candidates.SetGlobalBuffer((__gm__ int32_t*)cp);
    mapping.SetGlobalBuffer((__gm__ int32_t*)mp);
    native.SetGlobalBuffer((__gm__ int32_t*)np);
    counts.SetGlobalBuffer((__gm__ int32_t*)op);
    constexpr int T = 2048;
    TPipe pipe;
    TBuf<TPosition::VECCALC> tb, ib, pb, ob, xb, vb, cb, mb, mb2, workb;
    pipe.InitBuffer(tb, 16384 * 4);
    pipe.InitBuffer(ib, T * 4);
    pipe.InitBuffer(pb, T * 4);
    pipe.InitBuffer(ob, T * 4);
    pipe.InitBuffer(xb, T * 4);
    pipe.InitBuffer(vb, T * 4);
    pipe.InitBuffer(cb, 64);
    pipe.InitBuffer(mb, T / 8);
    pipe.InitBuffer(mb2, T / 8);
    pipe.InitBuffer(workb, T * 4);
    auto tab = tb.Get<int32_t>();
    auto ids = ib.Get<int32_t>();
    auto pages = pb.Get<int32_t>();
    auto compact = ob.Get<int32_t>();
    auto offsets = xb.Get<int32_t>();
    auto values = vb.Get<float>();
    auto count_ub = cb.Get<int32_t>();
    auto mask = mb.Get<uint8_t>();
    auto mask2 = mb2.Get<uint8_t>();
    auto work = workb.Get<float>();
    int unit = s.candidates < 0 ? 64 : 8;
    for (int row = GetBlockIdx(); row < s.rows; row += GetBlockNum()) {
        int v = visible.GetValue((int64_t)row * s.vs);
        v = v < 0 ? 0 : (v > s.width * 64 ? s.width * 64 : v);
        int limit = s.candidates < 0 ? (v + 63) / 64 : s.candidates;
        int written = 0, total = 0;
        // Cache residency can trim the table to a nonaligned page count. Copy
        // exactly that row; DataCopyPad supports unaligned GM row addresses too.
        DataCopyPad(tab, table[(int64_t)row * s.ts], DataCopyExtParams{1, (uint32_t)s.width * 4, 0, 0, 0},
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        for (int start = 0; start < limit; start += T) {
            int real = limit - start < T ? limit - start : T;
            int size = (real + 63) / 64 * 64;
            if (s.candidates < 0)
                CreateVecIndex(ids, (int32_t)start, size);
            else {
                Duplicate(ids, (int32_t)-1, size);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                DataCopyPad(ids, candidates[(int64_t)row * s.cs + start],
                            DataCopyExtParams{1, (uint32_t)real * 4, 0, 0, 0},
                            DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)((8 - real % 8) % 8), -1});
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
            }
            PipeBarrier<PIPE_V>();
            Cast(values, ids, RoundMode::CAST_ROUND, size);
            PipeBarrier<PIPE_V>();
            CompareScalar(mask, values, 0.0f, CMPMODE::GE, size);
            CompareScalar(mask2, values, (float)((v + unit - 1) / unit), CMPMODE::LT, size);
            PipeBarrier<PIPE_V>();
            And(mask.ReinterpretCast<uint16_t>(), mask.ReinterpretCast<uint16_t>(), mask2.ReinterpretCast<uint16_t>(),
                size / 16);
            if (s.candidates >= 0)
                ShiftRight(offsets, ids, (int32_t)3, size);
            else
                Adds(offsets, ids, (int32_t)0, size);
            PipeBarrier<PIPE_V>();
            Maxs(offsets, offsets, (int32_t)0, size);
            PipeBarrier<PIPE_V>();
            Mins(offsets, offsets, (int32_t)(s.width - 1), size);
            PipeBarrier<PIPE_V>();
            Muls(offsets, offsets, (int32_t)4, size);
            PipeBarrier<PIPE_V>();
            Gather(pages, tab, offsets.ReinterpretCast<uint32_t>(), (uint32_t)0, size);
            PipeBarrier<PIPE_V>();
            Cast(values, pages, RoundMode::CAST_ROUND, size);
            PipeBarrier<PIPE_V>();
            CompareScalar(mask2, values, 0.0f, CMPMODE::GT, size);
            PipeBarrier<PIPE_V>();
            And(mask.ReinterpretCast<uint16_t>(), mask.ReinterpretCast<uint16_t>(), mask2.ReinterpretCast<uint16_t>(),
                size / 16);
            PipeBarrier<PIPE_V>();
            CompareScalar(mask2, values, (float)s.pages, CMPMODE::LT, size);
            PipeBarrier<PIPE_V>();
            And(mask.ReinterpretCast<uint16_t>(), mask.ReinterpretCast<uint16_t>(), mask2.ReinterpretCast<uint16_t>(),
                size / 16);
            PipeBarrier<PIPE_V>();
            uint64_t count = 0;
            GatherMask(compact.ReinterpretCast<float>(), ids.ReinterpretCast<float>(), mask.ReinterpretCast<uint32_t>(),
                       true, size, GatherMaskParams{1, 1, 8, 0}, count);
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            if (count) {
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                DataCopyPad(mapping[(int64_t)row * s.stride + written], compact,
                            DataCopyExtParams{1, (uint32_t)count * 4, 0, 0, 0});
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
            }
            if (s.candidates < 0) {
                GatherMask(compact.ReinterpretCast<float>(), pages.ReinterpretCast<float>(),
                           mask.ReinterpretCast<uint32_t>(), true, size, GatherMaskParams{1, 1, 8, 0}, count);
                if (count) {
                    SetFlag<HardEvent::V_MTE3>(0);
                    WaitFlag<HardEvent::V_MTE3>(0);
                    DataCopyPad(native[(int64_t)row * s.stride + written], compact,
                                DataCopyExtParams{1, (uint32_t)count * 4, 0, 0, 0});
                    SetFlag<HardEvent::MTE3_V>(0);
                    WaitFlag<HardEvent::MTE3_V>(0);
                }
            }
            Cast(values, ids, RoundMode::CAST_ROUND, size);
            PipeBarrier<PIPE_V>();
            Muls(values, values, -(float)unit, size);
            PipeBarrier<PIPE_V>();
            Adds(values, values, (float)v, size);
            PipeBarrier<PIPE_V>();
            Maxs(values, values, 0.0f, size);
            PipeBarrier<PIPE_V>();
            Mins(values, values, (float)unit, size);
            PipeBarrier<PIPE_V>();
            Select(values, mask, values, 0.0f, SELMODE::VSEL_TENSOR_SCALAR_MODE, size);
            PipeBarrier<PIPE_V>();
            ReduceSum(count_ub.ReinterpretCast<float>(), values, work, size);
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            total += (int)count_ub.ReinterpretCast<float>().GetValue(0);
            written += (int)count;
            SetFlag<HardEvent::V_MTE2>(0);
            WaitFlag<HardEvent::V_MTE2>(0);
        }
        Duplicate(count_ub, (int32_t)total, 16);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopy(counts[(int64_t)row * 16], count_ub, 16);
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
    }
}
extern "C" void launch_index_meta(void* t, void* v, void* c, void* m, void* n, void* o, MetaShape s, void* stream) {
    index_meta<<<48, nullptr, stream>>>((GM_ADDR)t, (GM_ADDR)v, (GM_ADDR)c, (GM_ADDR)m, (GM_ADDR)n, (GM_ADDR)o, s);
}
