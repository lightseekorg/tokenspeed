#include "kernel_operator.h"
using namespace AscendC;

// Routing destinations are unique; invalid slots have no output contribution.
// Compact only this block's destinations before scalar UB stores, avoiding
// thousands of atomics on the discarded remote-expert sink.
__global__ __aicore__ void route_weights(GM_ADDR mp, GM_ADDR wp, GM_ADDR op, int n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int CAPACITY = 4096;
    GlobalTensor<int32_t> map;
    GlobalTensor<float> weights, output;
    map.SetGlobalBuffer((__gm__ int32_t*)mp);
    weights.SetGlobalBuffer((__gm__ float*)wp);
    output.SetGlobalBuffer((__gm__ float*)op);
    int chunk = ((n + GetBlockNum() - 1) / GetBlockNum() + 7) / 8 * 8;
    int first = GetBlockIdx() * chunk, count = n - first;
    if (count <= 0) return;
    if (count > chunk) count = chunk;
    TPipe pipe;
    TBuf<TPosition::VECCALC> mb, wb, fb, maskb, otherb, idsb, valuesb, ob;
    pipe.InitBuffer(mb, CAPACITY * 4);
    pipe.InitBuffer(wb, CAPACITY * 4);
    pipe.InitBuffer(fb, CAPACITY * 4);
    pipe.InitBuffer(maskb, CAPACITY / 8);
    pipe.InitBuffer(otherb, CAPACITY / 8);
    pipe.InitBuffer(idsb, CAPACITY * 4);
    pipe.InitBuffer(valuesb, CAPACITY * 4);
    pipe.InitBuffer(ob, CAPACITY * 4);
    auto ids = mb.Get<int32_t>();
    auto w = wb.Get<float>();
    auto f = fb.Get<float>();
    auto mask = maskb.Get<uint8_t>();
    auto other = otherb.Get<uint8_t>();
    auto selected = idsb.Get<int32_t>();
    auto values = valuesb.Get<float>();
    auto out = ob.Get<float>();
    int work = (n + 63) / 64 * 64;
    Duplicate(ids, (int32_t)-1, work);
    Duplicate(w, 0.0f, work);
    SetFlag<HardEvent::V_MTE2>(0);
    WaitFlag<HardEvent::V_MTE2>(0);
    DataCopyPad(ids, map, DataCopyExtParams{1, (uint32_t)n * 4, 0, 0, 0},
                DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
    DataCopyPad(w, weights, DataCopyExtParams{1, (uint32_t)n * 4, 0, 0, 0},
                DataCopyPadExtParams<float>{false, 0, 0, 0});
    SetFlag<HardEvent::MTE2_V>(0);
    WaitFlag<HardEvent::MTE2_V>(0);
    Cast(f, ids, RoundMode::CAST_ROUND, work);
    Duplicate(out, 0.0f, chunk);
    PipeBarrier<PIPE_V>();
    CompareScalar(mask, f, (float)first, CMPMODE::GE, work);
    CompareScalar(other, f, (float)(first + count), CMPMODE::LT, work);
    PipeBarrier<PIPE_V>();
    And(mask.ReinterpretCast<uint16_t>(), mask.ReinterpretCast<uint16_t>(), other.ReinterpretCast<uint16_t>(),
        work / 16);
    PipeBarrier<PIPE_V>();
    uint64_t selected_count = 0, weight_count = 0;
    GatherMask(selected.ReinterpretCast<float>(), ids.ReinterpretCast<float>(), mask.ReinterpretCast<uint32_t>(), true,
               work, GatherMaskParams{1, 1, 8, 0}, selected_count);
    GatherMask(values, w, mask.ReinterpretCast<uint32_t>(), true, work, GatherMaskParams{1, 1, 8, 0}, weight_count);
    SetFlag<HardEvent::V_S>(0);
    WaitFlag<HardEvent::V_S>(0);
    for (int i = 0; i < (int)selected_count && i < n; i++) {
        int dst = selected.GetValue(i) - first;
        uint32_t bits = values.ReinterpretCast<uint32_t>().GetValue(i);
        uint32_t magnitude = bits & 0x7fffffffu;
        if (magnitude == 0)
            bits = 0;
        else if (magnitude > 0x7f800000u)
            bits = 0x7fffffffu;
        if (dst >= 0 && dst < count) out.ReinterpretCast<uint32_t>().SetValue(dst, bits);
    }
    SetFlag<HardEvent::S_MTE3>(0);
    WaitFlag<HardEvent::S_MTE3>(0);
    DataCopyPad(output[first], out, DataCopyExtParams{1, (uint32_t)count * 4, 0, 0, 0});
}
extern "C" void launch_route_weights(void* map, void* weights, void* output, int n, int blocks, void* stream) {
    route_weights<<<blocks, nullptr, stream>>>((GM_ADDR)map, (GM_ADDR)weights, (GM_ADDR)output, n);
}
