#include "kernel_operator.h"
using namespace AscendC;

struct ShardLayout {
    int ranks, maximum, words;
    int offsets[16], counts[16];
};

__global__ __aicore__ void pad_token_shards(GM_ADDR xp, GM_ADDR op, ShardLayout shape) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int TILE = 1024;
    GlobalTensor<uint32_t> input, output;
    input.SetGlobalBuffer((__gm__ uint32_t*)xp);
    output.SetGlobalBuffer((__gm__ uint32_t*)op);
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, TILE * sizeof(uint32_t));
    auto local = buffer.Get<uint32_t>();
    int shard_words = shape.maximum * shape.words;
    int tiles = (shard_words + TILE - 1) / TILE;
    for (int job = GetBlockIdx(); job < shape.ranks * tiles; job += GetBlockNum()) {
        int rank = job / tiles, first = (job % tiles) * TILE;
        int count = shard_words - first;
        if (count > TILE) count = TILE;
        int live = shape.counts[rank] * shape.words - first;
        if (live < 0) live = 0;
        if (live > count) live = count;
        if (live < count) Duplicate(local, (uint32_t)0, TILE);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
        if (live) {
            DataCopyPad(local, input[(int64_t)shape.offsets[rank] * shape.words + first],
                        DataCopyExtParams{1, (uint32_t)live * 4, 0, 0, 0},
                        DataCopyPadExtParams<uint32_t>{false, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_MTE3>(0);
        WaitFlag<HardEvent::MTE2_MTE3>(0);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        DataCopyPad(output[(int64_t)rank * shard_words + first], local,
                    DataCopyExtParams{1, (uint32_t)count * 4, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
    }
}

extern "C" void launch_pad_token_shards(void* x, void* out, ShardLayout shape, void* stream) {
    pad_token_shards<<<48, nullptr, stream>>>((GM_ADDR)x, (GM_ADDR)out, shape);
}
