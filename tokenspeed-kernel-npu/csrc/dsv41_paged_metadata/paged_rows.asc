#include "kernel_operator.h"
using namespace AscendC;
struct PagedShape {
    int rows, w0, w1;
    int64_t s0, s1, l0, l1;
    int base0, stride0, capacity0, base1, stride1, capacity1;
};
__global__ __aicore__ void paged_rows(GM_ADDR s0p, GM_ADDR l0p, GM_ADDR s1p, GM_ADDR l1p, GM_ADDR op, GM_ADDR cp,
                                      PagedShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GlobalTensor<int32_t> source0, source1, lengths0, lengths1, output, counts;
    source0.SetGlobalBuffer((__gm__ int32_t*)s0p);
    source1.SetGlobalBuffer((__gm__ int32_t*)s1p);
    lengths0.SetGlobalBuffer((__gm__ int32_t*)l0p);
    lengths1.SetGlobalBuffer((__gm__ int32_t*)l1p);
    output.SetGlobalBuffer((__gm__ int32_t*)op);
    counts.SetGlobalBuffer((__gm__ int32_t*)cp);
    constexpr int MAX_WIDTH = 4096;
    TPipe pipe;
    TBuf<TPosition::VECCALC> ib, qb, pb, ob, tb, rb, mb0, mb1, cb;
    pipe.InitBuffer(ib, MAX_WIDTH * 4);
    pipe.InitBuffer(qb, MAX_WIDTH * 4);
    pipe.InitBuffer(pb, MAX_WIDTH * 4);
    pipe.InitBuffer(ob, MAX_WIDTH * 4);
    pipe.InitBuffer(tb, MAX_WIDTH * 4);
    pipe.InitBuffer(rb, MAX_WIDTH * 4);
    pipe.InitBuffer(mb0, MAX_WIDTH / 8);
    pipe.InitBuffer(mb1, MAX_WIDTH / 8);
    pipe.InitBuffer(cb, 32);
    auto ids = ib.Get<int32_t>();
    auto quotient = qb.Get<int32_t>();
    auto physical = pb.Get<int32_t>();
    auto compact = ob.Get<int32_t>();
    auto values = tb.Get<float>();
    auto columns = rb.Get<float>();
    auto valid = mb0.Get<uint8_t>();
    auto other = mb1.Get<uint8_t>();
    auto count_ub = cb.Get<int32_t>();
    int width = s.w0 + s.w1;
    CreateVecIndex(quotient, (int32_t)0, width);
    PipeBarrier<PIPE_V>();
    Cast(columns, quotient, RoundMode::CAST_ROUND, width);
    PipeBarrier<PIPE_V>();
    for (int row = GetBlockIdx(); row < s.rows; row += GetBlockNum()) {
        int n0 = lengths0.GetValue((int64_t)row * s.l0);
        int n1 = lengths1.GetValue((int64_t)row * s.l1);
        n0 = n0 < 0 ? 0 : (n0 > s.w0 ? s.w0 : n0);
        n1 = n1 < 0 ? 0 : (n1 > s.w1 ? s.w1 : n1);
        if (s.w0) DataCopy(ids, source0[(int64_t)row * s.s0], s.w0);
        if (s.w1) DataCopy(ids[s.w0], source1[(int64_t)row * s.s1], s.w1);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        Cast(values, ids, RoundMode::CAST_ROUND, width);
        if (s.w0) Duplicate(physical.ReinterpretCast<float>(), (float)s.capacity0, s.w0);
        if (s.w1) Duplicate(physical.ReinterpretCast<float>()[s.w0], (float)s.capacity1, s.w1);
        PipeBarrier<PIPE_V>();
        Compare(valid, values, physical.ReinterpretCast<float>(), CMPMODE::LT, width);
        CompareScalar(other, values, 0.0f, CMPMODE::GE, width);
        PipeBarrier<PIPE_V>();
        And(valid.ReinterpretCast<uint16_t>(), valid.ReinterpretCast<uint16_t>(), other.ReinterpretCast<uint16_t>(),
            width / 16);
        if (s.w0) Duplicate(physical.ReinterpretCast<float>(), (float)n0, s.w0);
        if (s.w1) Duplicate(physical.ReinterpretCast<float>()[s.w0], (float)(s.w0 + n1), s.w1);
        PipeBarrier<PIPE_V>();
        Compare(other, columns, physical.ReinterpretCast<float>(), CMPMODE::LT, width);
        PipeBarrier<PIPE_V>();
        And(valid.ReinterpretCast<uint16_t>(), valid.ReinterpretCast<uint16_t>(), other.ReinterpretCast<uint16_t>(),
            width / 16);
        ShiftRight(quotient, ids, (int32_t)6, width);
        PipeBarrier<PIPE_V>();
        if (s.w0) Muls(quotient, quotient, (int32_t)(s.stride0 - 64), s.w0);
        if (s.w1) Muls(quotient[s.w0], quotient[s.w0], (int32_t)(s.stride1 - 64), s.w1);
        PipeBarrier<PIPE_V>();
        Add(physical, ids, quotient, width);
        PipeBarrier<PIPE_V>();
        if (s.w0) Adds(physical, physical, (int32_t)s.base0, s.w0);
        if (s.w1) Adds(physical[s.w0], physical[s.w0], (int32_t)s.base1, s.w1);
        Duplicate(compact, (int32_t)-1, width);
        PipeBarrier<PIPE_V>();
        uint64_t count = 0;
        GatherMask(compact.ReinterpretCast<float>(), physical.ReinterpretCast<float>(),
                   valid.ReinterpretCast<uint32_t>(), true, width, GatherMaskParams{1, 1, 8, 0}, count);
        SetFlag<HardEvent::V_S>(0);
        WaitFlag<HardEvent::V_S>(0);
        count_ub.SetValue(0, (int32_t)count);
        SetFlag<HardEvent::V_MTE3>(0);
        WaitFlag<HardEvent::V_MTE3>(0);
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
        DataCopy(output[(int64_t)row * width], compact, width);
        DataCopyPad(counts[row], count_ub, DataCopyExtParams{1, 4, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(0);
        WaitFlag<HardEvent::MTE3_V>(0);
        SetFlag<HardEvent::MTE3_MTE2>(0);
        WaitFlag<HardEvent::MTE3_MTE2>(0);
    }
}
extern "C" void launch_paged_rows(void* s0, void* l0, void* s1, void* l1, void* out, void* counts, PagedShape shape,
                                  void* stream) {
    paged_rows<<<48, nullptr, stream>>>((GM_ADDR)s0, (GM_ADDR)l0, (GM_ADDR)s1, (GM_ADDR)l1, (GM_ADDR)out,
                                        (GM_ADDR)counts, shape);
}
