#include "kernel_operator.h"
using namespace AscendC;
constexpr int kSlots = 2;
__aicore__ inline int SMin(int a, int b) {
    return a < b ? a : b;
}
__aicore__ inline int SMax(int a, int b) {
    return a > b ? a : b;
}
constexpr IsResetLoad3dConfig kLoadConfig = {true, true};
struct ScanShape {
    int n, width, pages, parts, shards;
};

__global__ __aicore__ void scan_mix(GM_ADDR qp, GM_ADDR wp, GM_ADDR kp, GM_ADDR tp, GM_ADDR vp, GM_ADDR op, GM_ADDR sp,
                                    ScanShape shape) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    GlobalTensor<bfloat16_t> q, w, k;
    GlobalTensor<int32_t> table, visible;
    GlobalTensor<float> output;
    GlobalTensor<bfloat16_t> scratch;
    q.SetGlobalBuffer((__gm__ bfloat16_t*)qp);
    w.SetGlobalBuffer((__gm__ bfloat16_t*)wp);
    k.SetGlobalBuffer((__gm__ bfloat16_t*)kp);
    table.SetGlobalBuffer((__gm__ int32_t*)tp);
    visible.SetGlobalBuffer((__gm__ int32_t*)vp);
    output.SetGlobalBuffer((__gm__ float*)op);
    scratch.SetGlobalBuffer((__gm__ bfloat16_t*)sp);
    TPipe pipe;
    if ASCEND_IS_AIC {
        TBuf<TPosition::A1> aq;
        TBuf<TPosition::B1> bk;
        TBuf<TPosition::A2> a0;
        TBuf<TPosition::B2> b0;
        TBuf<TPosition::CO1> c0;
        pipe.InitBuffer(aq, kSlots * 64 * 128 * 2);
        pipe.InitBuffer(bk, kSlots * 128 * 128 * 2);
        pipe.InitBuffer(a0, kSlots * 64 * 128 * 2);
        pipe.InitBuffer(b0, kSlots * 128 * 128 * 2);
        pipe.InitBuffer(c0, kSlots * 64 * 128 * 4);

        int iteration = 0;
        const int core = GetBlockIdx();
        SetMMLayoutTransform(true);
        for (int job = core; job < ((shape.n + 1) / 2) * shape.parts; job += 24) {
            int row = (job / shape.parts) * 2, part = job % shape.parts;
            int v0 = SMin(SMax(visible.GetValue(row), 0), shape.width),
                v1 = row + 1 < shape.n ? SMin(SMax(visible.GetValue(row + 1), 0), shape.width) : 0;
            int extent = SMax(v0, v1), span = ((extent + shape.parts * 128 - 1) / (shape.parts * 128)) * 128;
            if (part * span >= extent) continue;
            // Keep both NZ layouts of the query pair in L0A. Physical pages
            // may diverge at any tile, so either row can still run alone.
            for (int layout = 0; layout < 3; layout++) {
                int m = layout == 0 ? 64 : 32;
                int offset = layout == 0 ? 0 : 64 * 128 + (layout - 1) * 32 * 128;
                auto al1 = aq.Get<bfloat16_t>()[offset];
                auto al0 = a0.Get<bfloat16_t>()[offset];
                for (int lane = 0; lane < (layout == 0 ? 2 : 1); lane++) {
                    int qr = SMin(row + (layout == 0 ? lane : layout - 1), shape.n - 1);
                    Nd2NzParams a{};
                    a.ndNum = 1;
                    a.nValue = 32;
                    a.dValue = 128;
                    a.srcDValue = 128;
                    a.dstNzC0Stride = m;
                    a.dstNzNStride = 1;
                    DataCopy(al1[lane * 32 * 16], q[(int64_t)qr * 32 * 128], a);
                }
                SetFlag<HardEvent::MTE2_MTE1>(0);
                WaitFlag<HardEvent::MTE2_MTE1>(0);
                LoadData3DParamsV2<bfloat16_t> la{};
                la.l1H = m / 16;
                la.l1W = 16;
                la.channelSize = 128;
                la.padList[3] = 255;
                la.mExtension = m;
                la.kExtension = 128;
                la.strideW = 1;
                la.strideH = 1;
                la.filterW = 1;
                la.filterH = 1;
                la.dilationFilterW = 1;
                la.dilationFilterH = 1;
                LoadData<kLoadConfig>(al0, al1, la);
            }
            SetFlag<HardEvent::MTE1_M>(0);
            WaitFlag<HardEvent::MTE1_M>(0);
            for (int start = part * span; start < SMin((part + 1) * span, extent); start += 128) {
                CrossCoreWaitFlag(4 + iteration % kSlots);
                int bank = iteration % kSlots;
                auto bl1 = bk.Get<bfloat16_t>()[bank * 128 * 128];
                auto bl0 = b0.Get<bfloat16_t>()[bank * 128 * 128];
                auto cl0 = c0.Get<float>()[bank * 64 * 128];
                int p00 = table.GetValue((int64_t)row * (shape.width / 64) + start / 64);
                int p01 =
                    start + 64 < shape.width ? table.GetValue((int64_t)row * (shape.width / 64) + start / 64 + 1) : 0;
                int p10 =
                    row + 1 < shape.n ? table.GetValue((int64_t)(row + 1) * (shape.width / 64) + start / 64) : p00;
                int p11 = row + 1 < shape.n && start + 64 < shape.width
                              ? table.GetValue((int64_t)(row + 1) * (shape.width / 64) + start / 64 + 1)
                              : p01;
                bool same = p00 == p10 && p01 == p11;
                for (int pass = 0; pass < (same ? 1 : 2); pass++) {
                    int m = same ? 64 : 32;
                    auto al0 = a0.Get<bfloat16_t>()[same ? 0 : 64 * 128 + pass * 32 * 128];
                    for (int page = 0; page < 2; page++) {
                        int id = page ? (pass ? p11 : p01) : (pass ? p10 : p00);
                        if (id <= 0 || id >= shape.pages) id = 0;
                        Nd2NzParams b{};
                        b.ndNum = 1;
                        b.nValue = 64;
                        b.dValue = 128;
                        b.srcDValue = 128;
                        b.dstNzC0Stride = 128;
                        b.dstNzNStride = 1;
                        DataCopy(bl1[page * 64 * 16], k[(int64_t)id * 64 * 128], b);
                    }
                    SetFlag<HardEvent::MTE2_MTE1>(0);
                    WaitFlag<HardEvent::MTE2_MTE1>(0);
                    LoadData2DParams lb{};
                    lb.repeatTimes = 64;
                    lb.srcStride = 1;
                    LoadData(bl0, bl1, lb);
                    SetFlag<HardEvent::MTE1_M>(0);
                    WaitFlag<HardEvent::MTE1_M>(0);
                    MmadParams mm{};
                    mm.m = m;
                    mm.n = 128;
                    mm.k = 128;
                    mm.cmatrixInitVal = true;
                    mm.unitFlag = 0;
                    Mmad(cl0, al0, bl0, mm);
                    SetFlag<HardEvent::M_FIX>(0);
                    WaitFlag<HardEvent::M_FIX>(0);
                    DataCopyCO12DstParams fix{};
                    fix.mSize = m;
                    fix.nSize = 128;
                    fix.dstStride = 128;
                    fix.srcStride = m;
                    fix.nz2ndEn = true;
                    // Preserve the existing BF16 dot-product rounding at the
                    // producer, halving the Cube-to-Vector scratch traffic.
                    fix.quantPre = QuantMode_t::F322BF16;
                    fix.unitFlag = 0;
                    SetFixpipeNz2ndFlag(1, 1, 1);
                    DataCopy(scratch[((int64_t)core * kSlots + iteration % kSlots) * 64 * 128 + pass * 32 * 128], cl0,
                             fix);
                    // Drain private L1/L0 owners before reuse; Cube/Vector overlap is
                    // carried by the two GM slots, not by unsafe buffer aliasing.
                    SetFlag<HardEvent::FIX_M>(1);
                    WaitFlag<HardEvent::FIX_M>(1);
                    SetFlag<HardEvent::M_MTE1>(1);
                    WaitFlag<HardEvent::M_MTE1>(1);
                    SetFlag<HardEvent::MTE1_MTE2>(1);
                    WaitFlag<HardEvent::MTE1_MTE2>(1);
                }
                CrossCoreSetFlag<2, PIPE_FIX>(2 + iteration % kSlots);
                iteration++;
            }
        }
        // Consume both initial ring credits after the final consumers finish.
        for (int slot = 0; slot < kSlots; slot++) {
            CrossCoreWaitFlag(4 + slot);
        }
        SetMMLayoutTransform(false);
    }
    if ASCEND_IS_AIV {
        int sub = GetBlockIdx() % 2, core = GetBlockIdx() / 2;
        TBuf<TPosition::VECCALC> data, half, weights, expanded_weights, acc, partial;
        pipe.InitBuffer(data, 32 * 128 * 4);
        pipe.InitBuffer(half, 32 * 128 * 2);
        pipe.InitBuffer(weights, 256);
        pipe.InitBuffer(expanded_weights, 32 * 128 * 4);
        pipe.InitBuffer(acc, 128 * 4);
        pipe.InitBuffer(partial, 128 * 4);
        auto x = data.Get<float>();
        auto h = half.Get<bfloat16_t>();
        auto wt = weights.Get<float>();
        auto sum = acc.Get<float>();
        auto tmp = partial.Get<float>();
        auto broadcast_weights = expanded_weights.Get<float>();
        for (int slot = 0; slot < kSlots; slot++) {
            CrossCoreSetFlag<2, PIPE_MTE2>(4 + slot);
            PipeBarrier<PIPE_MTE2>();
        }
        int iteration = 0;
        for (int job = core; job < ((shape.n + 1) / 2) * shape.parts; job += 24) {
            int base = (job / shape.parts) * 2, row = base + sub, part = job % shape.parts;
            int v0 = SMin(SMax(visible.GetValue(base), 0), shape.width),
                v1 = base + 1 < shape.n ? SMin(SMax(visible.GetValue(base + 1), 0), shape.width) : 0;
            int extent = SMax(v0, v1), span = ((extent + shape.parts * 128 - 1) / (shape.parts * 128)) * 128;
            DataCopy(wt[32].ReinterpretCast<bfloat16_t>(), w[(int64_t)SMin(row, shape.n - 1) * 32], 32);
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            Cast(wt, wt[32].ReinterpretCast<bfloat16_t>(), RoundMode::CAST_NONE, 32);
            SetFlag<HardEvent::V_S>(0);
            WaitFlag<HardEvent::V_S>(0);
            // Weights are constant across historical tiles for this query. Expand
            // once per job, then issue one vector multiply instead of 32 scalars.
            for (int head = 0; head < 32; head++) Duplicate(broadcast_weights[head * 128], wt.GetValue(head), 128);
            PipeBarrier<PIPE_V>();
            for (int start = part * span; start < SMin((part + 1) * span, extent); start += 128) {
                CrossCoreWaitFlag(2 + iteration % kSlots);
                DataCopy(h, scratch[((int64_t)core * kSlots + iteration % kSlots) * 64 * 128 + sub * 32 * 128],
                         32 * 128);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(x, h, RoundMode::CAST_NONE, 32 * 128);
                PipeBarrier<PIPE_V>();
                Maxs(x, x, 0.f, 32 * 128);
                PipeBarrier<PIPE_V>();
                Mul(x, x, broadcast_weights, 32 * 128);
                PipeBarrier<PIPE_V>();
                Cast(h, x, RoundMode::CAST_RINT, 32 * 128);
                PipeBarrier<PIPE_V>();
                Cast(x, h, RoundMode::CAST_NONE, 32 * 128);
                PipeBarrier<PIPE_V>();
                Duplicate(sum, 0.f, 128);
                PipeBarrier<PIPE_V>();
                int heads = 32 / shape.shards;
                for (int shard = 0; shard < shape.shards; shard++) {
                    for (int stride = heads / 2; stride > 0; stride /= 2) {
                        // Adjacent heads are contiguous: one instruction keeps
                        // the same reduction tree without per-head issue cost.
                        Add(x[shard * heads * 128], x[shard * heads * 128], x[(shard * heads + stride) * 128],
                            stride * 128);
                        PipeBarrier<PIPE_V>();
                    }
                    Cast(h, x[shard * heads * 128], RoundMode::CAST_RINT, 128);
                    PipeBarrier<PIPE_V>();
                    Cast(tmp, h, RoundMode::CAST_NONE, 128);
                    PipeBarrier<PIPE_V>();
                    Add(sum, sum, tmp, 128);
                    PipeBarrier<PIPE_V>();
                }
                Cast(h, sum, RoundMode::CAST_RINT, 128);
                PipeBarrier<PIPE_V>();
                Cast(sum, h, RoundMode::CAST_NONE, 128);
                PipeBarrier<PIPE_V>();
                if (row < shape.n) {
                    int vis = sub ? v1 : v0;
                    for (int page = 0; page < 2; page++) {
                        int col = start + page * 64;
                        if (col >= shape.width) continue;
                        int id = table.GetValue((int64_t)row * (shape.width / 64) + col / 64);
                        int valid = id > 0 && id < shape.pages ? SMin(SMax(vis - col, 0), 64) : 0;
                        if (valid == 0) {
                            Duplicate(sum[page * 64], -__builtin_inff(), 64);
                            PipeBarrier<PIPE_V>();
                        } else if (valid < 64) {
                            SetFlag<HardEvent::V_S>(1);
                            WaitFlag<HardEvent::V_S>(1);
                            for (int pos = valid; pos < 64; pos++) sum.SetValue(page * 64 + pos, -__builtin_inff());
                            SetFlag<HardEvent::S_V>(1);
                            WaitFlag<HardEvent::S_V>(1);
                        }
                    }
                    SetFlag<HardEvent::V_MTE3>(0);
                    WaitFlag<HardEvent::V_MTE3>(0);
                    DataCopy(output[(int64_t)row * shape.width + start], sum, SMin(128, shape.width - start));
                    SetFlag<HardEvent::MTE3_V>(0);
                    WaitFlag<HardEvent::MTE3_V>(0);
                }
                // A ready next GM slot must not let MTE2 overwrite x while the
                // previous Vector reductions still read it. Cross-core ready alone
                // does not order this consumer's private UB reuse.
                SetFlag<HardEvent::V_MTE2>(2);
                WaitFlag<HardEvent::V_MTE2>(2);
                CrossCoreSetFlag<2, PIPE_MTE3>(4 + iteration % kSlots);
                iteration++;
            }
        }
    }
}
extern "C" void launch_scan(void* q, void* w, void* k, void* table, void* visible, void* out, void* scratch, int n,
                            int width, int pages, int parts, int shards, void* stream) {
    ScanShape shape{n, width, pages, parts, shards};
    scan_mix<<<24, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)w, (GM_ADDR)k, (GM_ADDR)table, (GM_ADDR)visible,
                                      (GM_ADDR)out, (GM_ADDR)scratch, shape);
}
