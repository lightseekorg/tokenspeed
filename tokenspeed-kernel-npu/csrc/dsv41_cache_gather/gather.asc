#include "kernel_operator.h"
using namespace AscendC;
struct GatherShape {
    int64_t count, capacity, page_stride, row_stride;
    int batch, output_float;
};
template <typename Index>
__global__ __aicore__ void gather_rows(GM_ADDR cache_p, GM_ADDR slots_p, GM_ADDR out_p, GatherShape s) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GlobalTensor<uint16_t> cache, out;
    GlobalTensor<float> out_float;
    GlobalTensor<Index> slots;
    cache.SetGlobalBuffer((__gm__ uint16_t*)cache_p);
    slots.SetGlobalBuffer((__gm__ Index*)slots_p);
    out.SetGlobalBuffer((__gm__ uint16_t*)out_p);
    out_float.SetGlobalBuffer((__gm__ float*)out_p);
    TPipe pipe;
    TBuf<TPosition::VECCALC> data_buf, index_buf, float_buf;
    pipe.InitBuffer(data_buf, 64 * 512 * 2);
    pipe.InitBuffer(index_buf, 64 * sizeof(Index));
    pipe.InitBuffer(float_buf, 32 * 512 * 4);
    auto data = data_buf.Get<uint16_t>();
    auto ids = index_buf.Get<Index>();
    auto converted = float_buf.Get<float>();
    for (int64_t begin = (int64_t)GetBlockIdx() * s.batch; begin < s.count; begin += (int64_t)GetBlockNum() * s.batch) {
        int n = (int)((s.count - begin) < s.batch ? (s.count - begin) : s.batch);
        DataCopyExtParams ip{1, (uint32_t)(n * sizeof(Index)), 0, 0, 0};
        DataCopyPadExtParams<Index> pad{false, 0, 0, 0};
        DataCopyPad(ids, slots[begin], ip, pad);
        Duplicate(data, (uint16_t)0, n * 512);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
        SetFlag<HardEvent::MTE2_S>(0);
        WaitFlag<HardEvent::MTE2_S>(0);
        for (int i = 0; i < n; i++) {
            int64_t slot = (int64_t)ids.GetValue(i);
            if (slot >= 0 && slot < s.capacity) {
                int64_t offset = (slot / 64) * s.page_stride + (slot % 64) * s.row_stride;
                DataCopy(data[i * 512], cache[offset], 512);
            }
        }
        if (s.output_float) {
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            Cast(converted, data.ReinterpretCast<bfloat16_t>(), RoundMode::CAST_NONE, n * 512);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopy(out_float[begin * 512], converted, n * 512);
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        } else {
            SetFlag<HardEvent::MTE2_MTE3>(0);
            WaitFlag<HardEvent::MTE2_MTE3>(0);
            DataCopy(out[begin * 512], data, n * 512);
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        }
        SetFlag<HardEvent::S_MTE2>(0);
        WaitFlag<HardEvent::S_MTE2>(0);
    }
}
extern "C" void launch_gather(void* cache, void* slots, void* out, int64_t count, int64_t capacity, int64_t ps,
                              int64_t rs, int batch, int index64, int output_float, void* stream) {
    GatherShape s{count, capacity, ps, rs, batch, output_float};
    if (index64)
        gather_rows<int64_t><<<48, nullptr, stream>>>((GM_ADDR)cache, (GM_ADDR)slots, (GM_ADDR)out, s);
    else
        gather_rows<int32_t><<<48, nullptr, stream>>>((GM_ADDR)cache, (GM_ADDR)slots, (GM_ADDR)out, s);
}
