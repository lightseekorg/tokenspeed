#include "kernel_operator.h"
using namespace AscendC;

struct NGramShape {
    int batch, total, capacity, vocab, uniform, layers, heads, pad, ids64, ends64, resetBytes;
};

class NGram {
public:
    GlobalTensor<int64_t> snapshots, positions, slots, tail, previous, prefix, hashes;
    GlobalTensor<int64_t> tokenMap, primes, offsets, multipliers, idsLong, endsLong, resetLong;
    GlobalTensor<int32_t> cache, idsInt, endsInt, resetInt;
    GlobalTensor<uint8_t> reset, needsSeed, mask;
    NGramShape s;

    __aicore__ inline int64_t Token(int row) {
        int64_t value = s.ids64 ? idsLong.GetValue(row) : idsInt.GetValue(row);
        return value >= 0 && value < s.vocab ? value : -1;
    }
    __aicore__ inline int64_t End(int request) {
        return s.ends64 ? endsLong.GetValue(request) : endsInt.GetValue(request);
    }
    __aicore__ inline void History(int request, int64_t* out) {
        int64_t slot = slots.GetValue(request);
        bool explicitReset = s.resetBytes == 8   ? resetLong.GetValue(request) != 0
                             : s.resetBytes == 4 ? resetInt.GetValue(request) != 0
                                                 : reset.GetValue(request) != 0;
        bool seed = explicitReset || needsSeed.GetValue(slot);
        int64_t delta = cache.GetValue(slot) - positions.GetValue(request);
        // Same frontier-coverage guard as the shared GPU kernel. A bad seed
        // must fail on device instead of silently hashing a stale snapshot.
        if (seed && (delta < 0 || delta > 1)) trap();
        for (int col = 0; col < 3; col++) {
            int64_t value = seed ? snapshots.GetValue(request * 4 + col + 1 - delta) : tail.GetValue(slot * 3 + col);
            out[col] = value >= 0 && value < s.vocab ? value : -1;
        }
    }
    __aicore__ inline void Row(int row, int64_t* out) {
        if (row >= s.total) {
            out[0] = out[1] = out[2] = out[3] = -1;
            return;
        }
        int request, start;
        if (s.uniform > 0) {
            request = row / s.uniform;
            start = request * s.uniform;
        } else {
            int lo = 0, hi = s.batch;
            while (lo < hi) {
                int mid = (lo + hi) / 2;
                if (row >= End(mid))
                    lo = mid + 1;
                else
                    hi = mid;
            }
            request = lo;
            start = request ? End(request - 1) : 0;
        }
        int64_t history[3];
        History(request, history);
        out[0] = Token(row);
        for (int distance = 1; distance <= 3; distance++) {
            out[distance] = row - start >= distance ? Token(row - distance) : history[distance - (row - start) - 1];
        }
    }
    __aicore__ inline void Run() {
        int core = GetBlockIdx();
        TPipe pipe;
        TBuf<TPosition::VECCALC> buffer;
        pipe.InitBuffer(buffer, 3 * 32 * sizeof(int64_t));
        auto values = buffer.Get<int64_t>();
        // One writer owns the small metadata planes. Hash jobs are independent
        // and never read those outputs, so there is no cross-core dependency.
        if (core == 0) {
            for (int request = 0; request < s.batch; request++) {
                int64_t history[3];
                History(request, history);
                for (int col = 0; col < 3; col++) prefix.SetValue(request * 3 + col, history[col]);
            }
            for (int row = 0; row < s.capacity; row++) {
                int64_t tokens[4];
                Row(row, tokens);
                for (int col = 0; col < 3; col++) previous.SetValue(row * 3 + col, tokens[col + 1]);
                mask.SetValue(row, tokens[0] >= 0);
            }
            DataCacheCleanAndInvalid<int64_t, CacheLine::ENTIRE_DATA_CACHE>(previous);
            DataCacheCleanAndInvalid<int64_t, CacheLine::ENTIRE_DATA_CACHE>(prefix);
            DataCacheCleanAndInvalid<uint8_t, CacheLine::ENTIRE_DATA_CACHE>(mask);
        }
        for (int job = core; job < s.capacity * s.layers; job += 48) {
            int row = job / s.layers, layer = job % s.layers;
            int64_t tokens[4];
            Row(row, tokens);
            bool blocked = false;
            uint64_t rolling = 0;
            for (int shift = 0; shift < 4; shift++) {
                blocked = blocked || tokens[shift] == -1;
                uint64_t token = blocked ? s.pad : tokenMap.GetValue(tokens[shift]);
                rolling ^= token * static_cast<uint64_t>(multipliers.GetValue(layer * 4 + shift));
                if (shift) {
                    for (int head = 0; head < s.heads; head++) {
                        int column = (shift - 1) * s.heads + head;
                        int parameter = layer * 3 * s.heads + column;
                        uint64_t prime = primes.GetValue(parameter);
                        values.SetValue(column, rolling % prime + offsets.GetValue(parameter));
                    }
                }
            }
            SetFlag<HardEvent::S_MTE3>(0);
            WaitFlag<HardEvent::S_MTE3>(0);
            DataCopyExtParams copy{1, static_cast<uint32_t>(3 * s.heads * sizeof(int64_t)), 0, 0, 0};
            DataCopyPad(hashes[static_cast<int64_t>(job) * 3 * s.heads], values, copy);
            SetFlag<HardEvent::MTE3_S>(0);
            WaitFlag<HardEvent::MTE3_S>(0);
        }
    }
};

__global__ __aicore__ void prepare(GM_ADDR snapshots, GM_ADDR positions, GM_ADDR reset, GM_ADDR slots, GM_ADDR cache,
                                   GM_ADDR ends, GM_ADDR tail, GM_ADDR needsSeed, GM_ADDR ids, GM_ADDR previous,
                                   GM_ADDR mask, GM_ADDR prefix, GM_ADDR hashes, GM_ADDR tokenMap, GM_ADDR primes,
                                   GM_ADDR offsets, GM_ADDR multipliers, NGramShape shape) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    NGram op;
    op.s = shape;
    op.snapshots.SetGlobalBuffer((__gm__ int64_t*)snapshots);
    op.positions.SetGlobalBuffer((__gm__ int64_t*)positions);
    op.reset.SetGlobalBuffer((__gm__ uint8_t*)reset);
    op.resetLong.SetGlobalBuffer((__gm__ int64_t*)reset);
    op.resetInt.SetGlobalBuffer((__gm__ int32_t*)reset);
    op.slots.SetGlobalBuffer((__gm__ int64_t*)slots);
    op.cache.SetGlobalBuffer((__gm__ int32_t*)cache);
    op.endsLong.SetGlobalBuffer((__gm__ int64_t*)ends);
    op.endsInt.SetGlobalBuffer((__gm__ int32_t*)ends);
    op.tail.SetGlobalBuffer((__gm__ int64_t*)tail);
    op.needsSeed.SetGlobalBuffer((__gm__ uint8_t*)needsSeed);
    op.idsLong.SetGlobalBuffer((__gm__ int64_t*)ids);
    op.idsInt.SetGlobalBuffer((__gm__ int32_t*)ids);
    op.previous.SetGlobalBuffer((__gm__ int64_t*)previous);
    op.mask.SetGlobalBuffer((__gm__ uint8_t*)mask);
    op.prefix.SetGlobalBuffer((__gm__ int64_t*)prefix);
    op.hashes.SetGlobalBuffer((__gm__ int64_t*)hashes);
    op.tokenMap.SetGlobalBuffer((__gm__ int64_t*)tokenMap);
    op.primes.SetGlobalBuffer((__gm__ int64_t*)primes);
    op.offsets.SetGlobalBuffer((__gm__ int64_t*)offsets);
    op.multipliers.SetGlobalBuffer((__gm__ int64_t*)multipliers);
    op.Run();
}

extern "C" void launch_ngram(void* snapshots, void* positions, void* reset, void* slots, void* cache, void* ends,
                             void* tail, void* needsSeed, void* ids, void* previous, void* mask, void* prefix,
                             void* hashes, void* tokenMap, void* primes, void* offsets, void* multipliers,
                             NGramShape shape, void* stream) {
    prepare<<<48, nullptr, stream>>>((GM_ADDR)snapshots, (GM_ADDR)positions, (GM_ADDR)reset, (GM_ADDR)slots,
                                     (GM_ADDR)cache, (GM_ADDR)ends, (GM_ADDR)tail, (GM_ADDR)needsSeed, (GM_ADDR)ids,
                                     (GM_ADDR)previous, (GM_ADDR)mask, (GM_ADDR)prefix, (GM_ADDR)hashes,
                                     (GM_ADDR)tokenMap, (GM_ADDR)primes, (GM_ADDR)offsets, (GM_ADDR)multipliers, shape);
}
