#include "kernel_operator.h"
using namespace AscendC;

__global__ __aicore__ void check_indices(GM_ADDR input, int64_t n, int64_t upper, int bytes) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GlobalTensor<int32_t> i32;
    GlobalTensor<int64_t> i64;
    i32.SetGlobalBuffer((__gm__ int32_t*)input);
    i64.SetGlobalBuffer((__gm__ int64_t*)input);
    for (int64_t i = GetBlockIdx(); i < n; i += GetBlockNum()) {
        int64_t value = bytes == 8 ? i64.GetValue(i) : i32.GetValue(i);
        if (value < 0 || value >= upper) trap();
    }
}

extern "C" void launch_assert_indices(void* input, int64_t n, int64_t upper, int bytes, void* stream) {
    check_indices<<<48, nullptr, stream>>>((GM_ADDR)input, n, upper, bytes);
}
