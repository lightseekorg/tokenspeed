+namespace deep_gemm {
+
+// The MoE activation/quantization translation unit uses --use_fast_math, whereas
+// DeepGEMM does not. Spell out those instructions without changing GEMM arithmetic.
+__device__ __forceinline__ float swiglu_mul_ftz(float a, float b) {
+  float out;
+  asm("mul.ftz.f32 %0, %1, %2;" : "=f"(out) : "f"(a), "f"(b));
+  return out;
+}
+
+__device__ __forceinline__ float swiglu_div_ftz(float a, float b) {
+  float out;
+  asm("div.approx.ftz.f32 %0, %1, %2;" : "=f"(out) : "f"(a), "f"(b));
+  return out;
+}
+
+__device__ __forceinline__ float swiglu_bf16(__nv_bfloat16 up, __nv_bfloat16 gate) {
+  float g = __bfloat162float(gate);
+  float exp_arg = swiglu_mul_ftz(g, -1.44269504088896341f);
+  float exp_val, denom;
+  asm("ex2.approx.ftz.f32 %0, %1;" : "=f"(exp_val) : "f"(exp_arg));
+  asm("add.ftz.f32 %0, %1, 0f3f800000;" : "=f"(denom) : "f"(exp_val));
+  float value = swiglu_mul_ftz(swiglu_mul_ftz(g, swiglu_div_ftz(1.f, denom)),
+                               __bfloat162float(up));
+  return __bfloat162float(__float2bfloat16_rn(value));
+}
+
+template <uint32_t kRows, uint32_t kMathThreads, uint32_t kIntermediate>
+__device__ __forceinline__ void store_swiglu_quant(
+    __nv_bfloat16 const* paired_smem, __nv_fp8_e4m3* output, float* scales,
+    int64_t scale_leading_dim, int64_t row_start, int64_t row_end,
+    int64_t padded_row_start, uint32_t column_block) {
+  constexpr uint32_t kChannels = 128;
+  uint32_t warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+  for (uint32_t row = warp; row < kRows; row += kMathThreads / 32) {
+    if (row_start + row >= row_end) break;
+    uint32_t local = row * kChannels + lane * 4;
+    uint2 up_bits = *reinterpret_cast<uint2 const*>(paired_smem + local);
+    uint2 gate_bits = *reinterpret_cast<uint2 const*>(paired_smem + kRows * kChannels + local);
+    auto const* up = reinterpret_cast<__nv_bfloat16 const*>(&up_bits);
+    auto const* gate = reinterpret_cast<__nv_bfloat16 const*>(&gate_bits);
+    float values[4];
+#pragma unroll
+    for (uint32_t i = 0; i < 4; ++i) {
+      values[i] = swiglu_bf16(up[i], gate[i]);
+    }
+    // Start from actual data, preserving the reference's all-NaN-group result.
+    float amax = fmaxf(fmaxf(fabsf(values[0]), fabsf(values[1])),
+                      fmaxf(fabsf(values[2]), fabsf(values[3])));
+#pragma unroll
+    for (int mask = 16; mask > 0; mask >>= 1)
+      amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, mask));
+    float scale = amax != 0.f ? swiglu_div_ftz(448.f, amax) : 1.f;
+    float inverse;
+    asm("rcp.approx.ftz.f32 %0, %1;" : "=f"(inverse) : "f"(scale));
