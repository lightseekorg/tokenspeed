+++ b/csrc/nv_internal/tensorrt_llm/deep_gemm/fp8_gemm_impl.cuh
@@ -571,0 +572,59 @@
+#ifdef MOE_MBU_PREFIX_SCHEDULER
+  __shared__ uint32_t tile_prefix[kNumGroups + 1];
+  __shared__ uint32_t warp_totals[kNumThreads / 32];
+  if (threadIdx.x == 0) tile_prefix[0] = 0;
+  __syncthreads();
+  // Scan chunks so expert count need not match block or warp size.
+  for (uint32_t base = 0; base < kNumGroups; base += kNumThreads) {
+    const uint32_t group = base + threadIdx.x;
+    uint32_t partial = 0;
+    if (group < kNumGroups) {
+      const auto rows = problem_input.problem_n_offsets[group + 1] -
+                        problem_input.problem_n_offsets[group];
+      partial = ceil_div(rows, static_cast<int64_t>(BLOCK_N));
+    }
+#pragma unroll
+    for (int delta = 1; delta < 32; delta *= 2) {
+      const uint32_t other = __shfl_up_sync(0xffffffff, partial, delta);
+      if (lane_idx >= delta) partial += other;
+    }
+    if (lane_idx == 31) warp_totals[warp_idx] = partial;
+    __syncthreads();
+    if (warp_idx == 0) {
+      uint32_t total = lane_idx < kNumThreads / 32 ? warp_totals[lane_idx] : 0;
+#pragma unroll
+      for (int delta = 1; delta < 32; delta *= 2) {
+        const uint32_t other = __shfl_up_sync(0xffffffff, total, delta);
+        if (lane_idx >= delta) total += other;
+      }
+      if (lane_idx < kNumThreads / 32) warp_totals[lane_idx] = total;
+    }
+    __syncthreads();
+    if (group < kNumGroups) {
+      tile_prefix[group + 1] = tile_prefix[base] + partial +
+                               (warp_idx ? warp_totals[warp_idx - 1] : 0);
+    }
+    __syncthreads();
+  }
+#ifdef MOE_MBU_TILE_MAP_SCHEDULER
+  // Bounded shared lookup; larger inputs keep the prefix binary search.
+  __shared__ uint32_t tile_groups[2 * kNumGroups];
+  const uint32_t mapped_tiles = min(tile_prefix[kNumGroups], 2 * kNumGroups);
+  for (uint32_t tile = threadIdx.x; tile < mapped_tiles; tile += kNumThreads) {
+    uint32_t low = 0;
+    uint32_t high = kNumGroups;
+    while (low < high) {
+      const uint32_t mid = (low + high) / 2;
+      if (tile_prefix[mid + 1] <= tile)
+        low = mid + 1;
+      else
+        high = mid;
+    }
+    tile_groups[tile] = low;
+  }
+  __syncthreads();
+  auto scheduler = SchedulerType(problem_input, tile_prefix, tile_groups);
+#else
+  auto scheduler = SchedulerType(problem_input, tile_prefix);
+#endif
+#else
@@ -572,0 +632 @@
+#endif
