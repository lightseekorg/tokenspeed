+    uint32_t packed = 0;
+#pragma unroll
+    for (uint32_t i = 0; i < 4; ++i) {
+      __nv_fp8_e4m3 value(swiglu_mul_ftz(values[i], scale));
+      packed |= uint32_t(value.__x) << (8 * i);
+    }
+    *reinterpret_cast<uint32_t*>(output + (row_start + row) * kIntermediate +
+                                 column_block * kChannels + lane * 4) = packed;
+  }
+}
